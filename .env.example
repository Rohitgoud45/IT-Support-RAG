# LLM Provider selection: auto | gemini | openai | anthropic | mock
# "auto" detects based on which API key is provided below.
LLM_PROVIDER=auto

# API Keys (set at least one, or leave unset for offline mock mode):
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local/compatible endpoint (e.g. for Ollama / LM Studio / vLLM):
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional model override (defaults: gemini-3.5-flash, gpt-4o-mini, claude-sonnet-5-5)
# LLM_MODEL=

# Retrieval tuning (tune MAX_DISTANCE using the eval harness)
TOP_K=4
MAX_DISTANCE=0.75
CHUNK_STRATEGY=paragraph   # paragraph | fixed
CHUNK_SIZE=800
CHUNK_OVERLAP=150
